

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:linear-gradient(135deg,#1e3c72,#2a5298);
    min-height:100vh;
    color:#fff;
}

/* Navbar */

nav{
    width:100%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:18px 8%;
    background:rgba(255,255,255,0.08);
    backdrop-filter:blur(15px);
    box-shadow:0 5px 20px rgba(0,0,0,.2);
}

.logo{
    font-size:28px;
    font-weight:700;
    letter-spacing:1px;
}

nav ul{
    display:flex;
    list-style:none;
}

nav ul li{
    margin-left:30px;
}

nav ul li a{
    color:white;
    text-decoration:none;
    font-weight:500;
    transition:.3s;
}

nav ul li a:hover{
    color:#00e5ff;
}

/* Hero Section */

.hero{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:70px 8%;
    flex-wrap:wrap;
}

.hero-text{
    max-width:600px;
}

.hero-text h1{
    font-size:55px;
    margin-bottom:20px;
}

.hero-text span{
    color:#00e5ff;
}

.hero-text p{
    color:#ddd;
    line-height:1.8;
    margin-bottom:30px;
}

.btn{
    display:inline-block;
    padding:15px 35px;
    background:#00e5ff;
    color:#222;
    border-radius:40px;
    text-decoration:none;
    font-weight:bold;
    transition:.4s;
}

.btn:hover{
    background:white;
    transform:translateY(-5px);
}

/* Dashboard */

.dashboard{
    padding:60px 8%;
}

.dashboard h2{
    text-align:center;
    margin-bottom:40px;
    font-size:40px;
}

/* Cards */

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:30px;
}

.card{
    background:rgba(255,255,255,.12);
    backdrop-filter:blur(15px);
    border-radius:20px;
    padding:30px;
    text-align:center;
    transition:.4s;
    border:1px solid rgba(255,255,255,.15);
}

.card:hover{
    transform:translateY(-10px);
    box-shadow:0 15px 35px rgba(0,0,0,.35);
}

.card i{
    font-size:55px;
    color:#00e5ff;
    margin-bottom:20px;
}

.card h3{
    margin-bottom:15px;
}

.card p{
    color:#ddd;
}

/* Profile */

.profile{
    display:flex;
    align-items:center;
    gap:20px;
    background:rgba(255,255,255,.1);
    padding:25px;
    border-radius:20px;
    margin-top:50px;
}

.profile img{
    width:90px;
    height:90px;
    border-radius:50%;
    border:4px solid white;
}

.profile h3{
    margin-bottom:8px;
}

/* Table */

table{
    width:100%;
    margin-top:40px;
    border-collapse:collapse;
    overflow:hidden;
    border-radius:15px;
}

table thead{
    background:#00bcd4;
}

table th,
table td{
    padding:18px;
    text-align:left;
}

table tbody tr{
    background:rgba(255,255,255,.08);
}

table tbody tr:nth-child(even){
    background:rgba(255,255,255,.13);
}

table tbody tr:hover{
    background:rgba(255,255,255,.18);
}

/* Buttons */

button{
    padding:12px 25px;
    border:none;
    border-radius:30px;
    background:#00e5ff;
    cursor:pointer;
    font-weight:600;
    transition:.3s;
}

button:hover{
    transform:scale(1.05);
    background:white;
}

/* Form */

form{
    margin-top:40px;
    background:rgba(255,255,255,.08);
    padding:30px;
    border-radius:20px;
}

input,
select,
textarea{
    width:100%;
    padding:15px;
    margin:12px 0;
    border:none;
    border-radius:12px;
    outline:none;
}

input:focus,
textarea:focus{
    border:2px solid #00e5ff;
}

/* Footer */

footer{
    margin-top:60px;
    text-align:center;
    padding:25px;
    background:rgba(255,255,255,.08);
}

/* Scrollbar */

::-webkit-scrollbar{
    width:10px;
}

::-webkit-scrollbar-thumb{
    background:#00e5ff;
    border-radius:20px;
}

/* Animation */

@keyframes fadeIn{
    from{
        opacity:0;
        transform:translateY(40px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.hero,
.card,
.profile,
table,
form{
    animation:fadeIn .8s ease;
}

/* Responsive */

@media(max-width:900px){

.hero{
    text-align:center;
    justify-content:center;
}

.hero-text h1{
    font-size:38px;
}

.profile{
    flex-direction:column;
    text-align:center;
}

nav{
    flex-direction:column;
}

nav ul{
    margin-top:20px;
}

nav ul li{
    margin:10px;
}

}
